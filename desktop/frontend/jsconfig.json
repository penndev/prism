{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@bindings/*": ["./bindings/*"]
    },
    "target": "ESNext",
    "module": "ESNext",
    "checkJs": true,
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },
  "include": ["src", "bindings"],
  "exclude": ["node_modules", "dist"]
}